{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git remote:*)",
      "Bash(git rev-parse:*)",
      "Bash(git merge-base:*)",
      "Bash(git ls-files:*)",
      "Bash(git check-ignore:*)",
      "Bash(git fetch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git merge origin/main:*)",
      "Bash(git push -u origin claude/:*)",
      "Bash(git push origin claude/:*)",
      "Bash(git push --set-upstream origin claude/:*)",
      "Bash(git push origin --delete claude/:*)",
      "Bash(git branch -d:*)",
      "mcp__github__get_me",
      "mcp__github__get_commit",
      "mcp__github__get_file_contents",
      "mcp__github__get_check_run",
      "mcp__github__get_job_logs",
      "mcp__github__get_label",
      "mcp__github__list_branches",
      "mcp__github__list_commits",
      "mcp__github__list_issues",
      "mcp__github__list_pull_requests",
      "mcp__github__pull_request_read",
      "mcp__github__search_code",
      "mcp__github__search_issues",
      "mcp__github__search_pull_requests",
      "mcp__github__actions_list",
      "mcp__github__actions_get",
      "mcp__github__create_branch",
      "mcp__github__create_pull_request",
      "mcp__github__update_pull_request",
      "mcp__github__merge_pull_request",
      "mcp__github__add_issue_comment",
      "mcp__github__add_reply_to_pull_request_comment",
      "mcp__github__resolve_review_thread",
      "mcp__github__issue_read",
      "mcp__github__issue_write",
      "mcp__github__subscribe_pr_activity",
      "mcp__github__unsubscribe_pr_activity",
      "Bash(sh ./nfl.sh:*)",
      "Bash(./nfl.ps1:*)",
      "Bash(.\\nfl.ps1:*)",
      "Bash(.venv-linux/bin/python:*)",
      "Bash(.venv/Scripts/python.exe:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run python:*)",
      "Bash(python3 scripts/:*)",
      "Bash(python scripts/:*)"
    ],
    "ask": [
      "Bash(sh ./nfl.sh setup:*)",
      "Bash(./nfl.ps1 setup:*)",
      "Bash(.\\nfl.ps1 setup:*)",
      "Read(docs/backlog-archive/**)",
      "Read(docs/changelog-archive/**)"
    ],
    "deny": [
      "Bash(git add -A:*)",
      "Bash(git add --all:*)",
      "Bash(git add .)",
      "Bash(git add .:*)",
      "Bash(git add -u:*)",
      "Bash(git commit -a:*)",
      "Bash(git commit --all:*)",
      "Bash(git commit --amend:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push origin main:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git push origin HEAD:main)",
      "Bash(git push origin +:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git branch -D:*)",
      "Bash(git rebase:*)",
      "Bash(git reset --hard:*)",
      "Bash(git checkout --:*)",
      "Bash(git restore:*)",
      "Bash(git clean:*)",
      "Bash(git stash:*)",
      "Bash(git filter-branch:*)",
      "Bash(git reflog expire:*)",
      "Bash(git gc --prune:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "mcp__github__create_or_update_file",
      "mcp__github__push_files",
      "mcp__github__delete_file",
      "mcp__github__create_repository",
      "mcp__github__fork_repository",
      "Edit(data/standings/inbox/**)",
      "Edit(data/runs/**/inputs/**)",
      "Edit(tests/fixtures/supplied/**)",
      "Edit(uv.lock)",
      "Edit(.git/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(data/standings/inbox/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start.py\" 2>/dev/null || python \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start.py\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_bash.py\" 2>/dev/null || python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_bash.py\" 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
