.venv/
.uv-cache/
.cowork-venv/
.cowork-uv-cache/
.artifact-runtime/
scripts/node_modules/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.hypothesis/
.ruff_cache/
*.egg-info/
data/runs/*
!data/runs/.gitkeep
data/registry/*
!data/registry/.gitkeep
data/models/*
!data/models/.gitkeep
# Standings intake, same rule as data/runs: raw DraftKings exports Ben pulled by
# hand and the normalized artifacts derived from them are bulk operator data, not
# source. 18 exports and one normalized field already come to ~58MB. The small
# records that are worth keeping are listed back in below: the dispositions are a
# record of Ben's own rulings, and the checklists are the working surface.
data/standings/inbox/*
!data/standings/inbox/.gitkeep
data/standings/normalized/*
!data/standings/normalized/.gitkeep
outputs/*
!outputs/.gitkeep
operator_input.xlsx

# doctor() probes the workspace filesystem in place and cannot remove the probe
# directory when the workspace forbids deletion, which a Cowork bridge mount
# does. The name is stable so the leftovers are identifiable and ignorable.
.nfl-doctor-probe-*/

# Scratch that a session could not delete itself. Safe to remove by hand.
_to_delete/

# Claude Code: personal instructions and locally saved permission approvals stay
# out of the shared repo; .claude/settings.json, rules and skills are tracked.
CLAUDE.local.md
.claude/settings.local.json
