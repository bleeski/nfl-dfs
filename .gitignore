.venv/
.uv-cache/
.venv-linux/
.uv-cache-linux/
.artifact-runtime/
scripts/node_modules/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.hypothesis/
.ruff_cache/
*.egg-info/
data/runs/*
!data/runs/.gitkeep
data/registry/*
!data/registry/.gitkeep
data/models/*
!data/models/.gitkeep
# Standings intake, same rule as data/runs: raw DraftKings exports Ben pulled by
# hand and the normalized artifacts derived from them are bulk operator data, not
# source. 18 exports and one normalized field already come to ~58MB. The small
# records that are worth keeping are listed back in below: the dispositions are a
# record of Ben's own rulings, and the checklists are the working surface.
data/standings/inbox/*
!data/standings/inbox/.gitkeep
data/standings/normalized/*
!data/standings/normalized/.gitkeep
outputs/*
!outputs/.gitkeep
operator_input.xlsx

# doctor() probes the workspace filesystem in place and cannot remove the probe
# directory when the workspace forbids deletion, which a Cowork bridge mount
# does. The name is stable so the leftovers are identifiable and ignorable.
.nfl-doctor-probe-*/

# Scratch that a session could not delete itself. Safe to remove by hand.
_to_delete/

# Claude Code: personal instructions and locally saved permission approvals stay
# out of the shared repo; .claude/settings.json, rules and skills are tracked.
CLAUDE.local.md
.claude/settings.local.json

# Operator run outputs that landed at the repo root instead of under data/runs/.
# Filled DK entry templates, official-status captures and generated portfolio
# policies are per-slate artifacts bound to a run's inputs and hashes; the run
# folder is their home and the copy at root is a convenience duplicate. Anchored
# to the root only, so the same names stay visible anywhere else in the tree.
/DKEntries_*.csv
/*_official_status.csv
/*_portfolio_policy_v*.json

# Scaffolding from earlier sessions, verified redundant on 2026-09-16 and kept
# on disk rather than deleted, per this repo's never-delete posture.
#   patches/ holds slate-day-engine-changes.patch and its commit script. Every
#   marker from all six of its hunks is present in main (embedded_pool_start,
#   EXCLUDE_UNRESOLVED_UNAVAILABLE, write_pool_scores,
#   DIAGNOSTIC_NOT_AN_UPLOAD_AUTHORIZATION, the moved unavailable vocabulary and
#   the twenty-entry fixture); the work landed under 7edddee, not as its own
#   commit, which is why the patch no longer applies in either direction.
#   "Claude outputs/" was the Cowork drop folder. Its two documents are byte-
#   identical to the tracked copies in docs/session-prompts/; the rest is run
#   output. Cowork is retired as of 2026-09-17 and nothing writes here any more;
#   the entry stays so an existing folder on Ben's box remains ignored.
/patches/
/Claude outputs/

# Derived session state. `claims.json` is the coordination primitive between
# concurrent Claude Code instances and has to travel; everything else here is
# regenerated by scripts/repo_state.py and would only create merge conflicts.
state/*
!state/.gitkeep
!state/claims.json
